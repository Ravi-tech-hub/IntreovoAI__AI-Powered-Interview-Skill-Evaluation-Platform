PORT=5000
NODE_ENV=development

# Use either MONGO_URL or MONGO_URI. MONGO_URL is kept because this project already used it.
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database-name>
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database-name>

JWT_SECRET=<long-random-secret>
JWT_EXPIRE=7d

GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

CORS_ORIGIN=http://localhost:5173
MAX_RESUME_FILE_SIZE_MB=5
